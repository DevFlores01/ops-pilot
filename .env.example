# Application
APP_NAME=OpsPilot
APP_VERSION=0.2.1
ENVIRONMENT=development
DEBUG=false

# OpenAI (optional, not used with Ollama)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local LLM
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Local AWS / Floci
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=opspilot-runbooks

# PostgreSQL / pgvector
POSTGRES_PASSWORD=replace_with_your_existing_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot

# Embedding model
EMBEDDING_MODEL=nomic-embed-text

# RAG configuration
RAG_MIN_SIMILARITY=0.55

# API authentication
OPSPILOT_API_KEY=replace_with_your_generated_secure_token